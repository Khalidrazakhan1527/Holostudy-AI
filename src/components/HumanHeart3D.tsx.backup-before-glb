import { Canvas } from '@react-three/fiber'
import { Html, OrbitControls, Stars } from '@react-three/drei'
import type { ThreeEvent } from '@react-three/fiber'
import { useState } from 'react'
import * as THREE from 'three'

type HeartPart = {
  id: string
  name: string
  description: string
  color: string
  position: [number, number, number]
  scale: [number, number, number]
}

const HEART_PARTS: HeartPart[] = [
  {
    id: 'right-atrium',
    name: 'Right Atrium',
    description: 'Receives deoxygenated blood returning from the body.',
    color: '#268bff',
    position: [-0.75, 0.8, 0],
    scale: [0.65, 0.72, 0.48],
  },
  {
    id: 'right-ventricle',
    name: 'Right Ventricle',
    description: 'Pumps deoxygenated blood toward the lungs.',
    color: '#2876ed',
    position: [-0.55, -0.25, 0.02],
    scale: [0.7, 0.85, 0.5],
  },
  {
    id: 'left-atrium',
    name: 'Left Atrium',
    description: 'Receives oxygenated blood returning from the lungs.',
    color: '#f05b70',
    position: [0.65, 0.85, 0],
    scale: [0.63, 0.68, 0.46],
  },
  {
    id: 'left-ventricle',
    name: 'Left Ventricle',
    description: 'Pumps oxygenated blood into systemic circulation.',
    color: '#e83d54',
    position: [0.55, -0.3, 0.04],
    scale: [0.72, 0.92, 0.53],
  },
]

function HeartChamber({
  part,
  selected,
  showLabels,
  onSelect,
}: {
  part: HeartPart
  selected: boolean
  showLabels: boolean
  onSelect: (part: HeartPart) => void
}) {
  return (
    <group position={part.position} scale={part.scale}>
      <mesh
        onClick={(event: ThreeEvent<MouseEvent>) => {
          event.stopPropagation()
          onSelect(part)
        }}
        onPointerOver={() => {
          document.body.style.cursor = 'pointer'
        }}
        onPointerOut={() => {
          document.body.style.cursor = 'auto'
        }}
      >
        <sphereGeometry args={[1, 40, 32]} />
        <meshPhysicalMaterial
          color={selected ? '#ffffff' : part.color}
          emissive={part.color}
          emissiveIntensity={selected ? 0.85 : 0.28}
          roughness={0.32}
          metalness={0.04}
          clearcoat={0.7}
          clearcoatRoughness={0.25}
        />
      </mesh>

      <mesh scale={1.035}>
        <sphereGeometry args={[1, 24, 20]} />
        <meshBasicMaterial
          color={part.color}
          wireframe
          transparent
          opacity={selected ? 0.65 : 0.13}
          depthWrite={false}
        />
      </mesh>

      {selected && (
        <mesh scale={1.09}>
          <sphereGeometry args={[1, 24, 20]} />
          <meshBasicMaterial
            color="#ffffff"
            wireframe
            transparent
            opacity={0.2}
          />
        </mesh>
      )}

      {showLabels && (
        <Html
          position={[0, 0, 1.15]}
          center
          distanceFactor={8}
          style={{ pointerEvents: 'none', whiteSpace: 'nowrap' }}
        >
          <span
            style={{
              color: '#e8f7ff',
              fontSize: 11,
              fontWeight: 600,
              padding: '4px 7px',
              borderRadius: 5,
              background: 'rgba(5, 15, 35, 0.78)',
              border: `1px solid ${part.color}`,
            }}
          >
            {part.name}
          </span>
        </Html>
      )}
    </group>
  )
}

function Vessel({
  points,
  color,
  radius = 0.12,
}: {
  points: [number, number, number][]
  color: string
  radius?: number
}) {
  const curve = new THREE.CatmullRomCurve3(
    points.map((point) => new THREE.Vector3(...point)),
  )

  return (
    <group>
      <mesh>
        <tubeGeometry args={[curve, 32, radius, 12, false]} />
        <meshStandardMaterial
          color={color}
          emissive={color}
          emissiveIntensity={0.35}
          roughness={0.3}
          metalness={0.08}
        />
      </mesh>
      <mesh>
        <tubeGeometry args={[curve, 32, radius * 1.28, 8, false]} />
        <meshBasicMaterial
          color={color}
          transparent
          opacity={0.12}
          depthWrite={false}
        />
      </mesh>
    </group>
  )
}

function BloodFlowParticles({ running }: { running: boolean }) {
  const particles = Array.from({ length: 12 }, (_, index) => {
    const angle = (index / 12) * Math.PI * 2

    return {
      position: [
        Math.cos(angle) * 0.18,
        -1.15 + (index % 4) * 0.55,
        0.62 + Math.sin(angle) * 0.08,
      ] as [number, number, number],
    }
  })

  return (
    <group>
      {particles.map((particle, index) => (
        <mesh key={index} position={particle.position}>
          <sphereGeometry args={[0.035, 12, 12]} />
          <meshBasicMaterial
            color={running ? (index % 2 === 0 ? '#ff6a86' : '#58b9ff') : '#7d91a8'}
            transparent
            opacity={running ? 0.95 : 0.25}
          />
        </mesh>
      ))}
    </group>
  )
}

export type HumanHeart3DProps = {
  showLabels?: boolean
  autoRotate?: boolean
  simulationOn?: boolean
  displayMode?: 'default' | 'dark' | 'glass'
}

export default function HumanHeart3D({
  showLabels = true,
  autoRotate = false,
  simulationOn = true,
  displayMode = 'default',
}: HumanHeart3DProps) {
  const [selectedPart, setSelectedPart] = useState<HeartPart | null>(null)
  const [isSplit, setIsSplit] = useState(false)

  const backgroundColor =
    displayMode === 'glass' ? '#071b2b' : displayMode === 'dark' ? '#030711' : '#081321'

  return (
    <div
      style={{
        position: 'absolute',
        inset: 0,
        overflow: 'hidden',
        background: `radial-gradient(ellipse at center, ${backgroundColor} 0%, #030711 100%)`,
      }}
    >
      <Canvas
        camera={{ position: [0, 0.2, 8], fov: 42 }}
        dpr={[1, 1.7]}
        gl={{ antialias: true, alpha: true }}
      >
        <color attach="background" args={['#030711']} />
        <ambientLight intensity={1.1} />
        <pointLight position={[3, 4, 5]} intensity={35} color="#a4dfff" />
        <pointLight position={[-4, 1, 2]} intensity={22} color="#2c83ff" />
        <pointLight position={[2, -3, -2]} intensity={20} color="#ff526f" />

        <Stars radius={45} depth={35} count={650} factor={2} fade speed={0.3} />

        <group position={[0, -0.05, 0]}>
          {/* Four simplified heart chambers */}
          {HEART_PARTS.map((part) => {
            const splitOffsets: Record<string, [number, number, number]> = {
              'right-atrium': [-0.8, 0.55, 0.25],
              'right-ventricle': [-0.8, -0.65, 0.25],
              'left-atrium': [0.8, 0.55, 0.25],
              'left-ventricle': [0.8, -0.65, 0.25],
            }
            const offset = splitOffsets[part.id] ?? [0, 0, 0]
            const displayPart = {
              ...part,
              position: isSplit
                ? [
                    part.position[0] + offset[0],
                    part.position[1] + offset[1],
                    part.position[2] + offset[2],
                  ] as [number, number, number]
                : part.position,
            }

            return (
              <HeartChamber
                key={part.id}
                part={displayPart}
                selected={selectedPart?.id === part.id}
                showLabels={showLabels}
                onSelect={setSelectedPart}
              />
            )
          })}

          {/* Major vessel representations */}
          <group position={isSplit ? [-0.45, 0.2, 0.25] : [0, 0, 0]}>
          <Vessel
            color="#3294ff"
            radius={0.16}
            points={[
              [-0.85, 2.05, -0.05],
              [-0.9, 1.55, -0.05],
              [-0.82, 1.2, -0.02],
            ]}
          />
          <Vessel
            color="#f04c61"
            radius={0.18}
            points={[
              [0.45, 1.5, 0],
              [0.35, 2.0, 0],
              [0.55, 2.4, 0],
              [1.1, 2.35, 0],
              [1.35, 1.95, 0],
            ]}
          />
          <Vessel
            color="#9a6cff"
            radius={0.105}
            points={[
              [-0.1, 0.7, 0.25],
              [0.0, 1.0, 0.28],
              [0.15, 1.2, 0.2],
            ]}
          />
          <Vessel
            color="#4d9dff"
            radius={0.1}
            points={[
              [-0.4, -0.2, 0.2],
              [-0.9, -0.55, 0.2],
              [-1.25, -0.85, 0.1],
            ]}
          />
          </group>

          <BloodFlowParticles running={simulationOn} />

          {/* Holographic base */}
          <group position={[0, -1.8, 0]}>
            {[1.5, 1.95, 2.4].map((radius, index) => (
              <mesh
                key={radius}
                rotation={[-Math.PI / 2, 0, 0]}
                position={[0, index * 0.015, 0]}
              >
                <torusGeometry args={[radius, 0.009, 8, 100]} />
                <meshBasicMaterial
                  color={index === 1 ? '#ff5f8f' : '#49cfff'}
                  transparent
                  opacity={0.6 - index * 0.12}
                />
              </mesh>
            ))}
          </group>
        </group>

        <OrbitControls
          makeDefault
          enableDamping
          dampingFactor={0.07}
          minDistance={4.5}
          maxDistance={13}
          autoRotate={autoRotate}
          autoRotateSpeed={0.65}
        />
      </Canvas>

      <div
        style={{
          position: 'absolute',
          left: 16,
          bottom: 14,
          color: '#a6cce4',
          fontSize: 10,
          letterSpacing: 1.5,
          pointerEvents: 'none',
        }}
      >
        HOLOGRAPHIC CARDIAC MODEL · SELECT A CHAMBER
      </div>

      <div
        style={{
          position: 'absolute',
          top: 14,
          right: 14,
          display: 'flex',
          gap: 8,
          zIndex: 5,
        }}
      >
        <button
          type="button"
          onClick={() => setIsSplit((value) => !value)}
          aria-pressed={isSplit}
          style={{
            padding: '9px 12px',
            borderRadius: 8,
            border: '1px solid rgba(93, 205, 255, 0.55)',
            background: isSplit ? 'rgba(40, 120, 190, 0.9)' : 'rgba(4, 15, 31, 0.92)',
            color: '#e8f7ff',
            fontSize: 12,
            fontWeight: 600,
            cursor: 'pointer',
          }}
        >
          {isSplit ? 'Reset Model' : 'Split Model'}
        </button>
      </div>

      {selectedPart && (
        <section
          aria-live="polite"
          style={{
            position: 'absolute',
            top: 16,
            left: 16,
            width: 'min(260px, calc(100% - 32px))',
            padding: 14,
            borderRadius: 12,
            border: `1px solid ${selectedPart.color}99`,
            background: 'rgba(4, 15, 31, 0.94)',
            boxShadow: '0 10px 36px rgba(0,0,0,0.3)',
            color: '#e8f7ff',
            backdropFilter: 'blur(12px)',
          }}
        >
          <div
            style={{
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              gap: 10,
            }}
          >
            <strong style={{ fontSize: 14 }}>{selectedPart.name}</strong>
            <button
              type="button"
              aria-label="Close heart structure details"
              onClick={() => setSelectedPart(null)}
              style={{
                border: 0,
                color: '#c5e8fa',
                background: 'transparent',
                cursor: 'pointer',
                fontSize: 20,
              }}
            >
              ×
            </button>
          </div>
          <p style={{ fontSize: 12, lineHeight: 1.6, color: '#a9c6db', marginBottom: 0 }}>
            {selectedPart.description}
          </p>
        </section>
      )}
    </div>
  )
}
