type NeuronConnectionDetail = {
  neuronId: number
  neuronLabel: string
  weight: number
  inputValue: number
  contribution: number
}

function getNeuronConnectionDetails(neuron: SelectedNeuron) {
  const layerCounts = [4, 5, 4, 3]
  const layerStarts = [0, 4, 9, 13]

  const incoming: NeuronConnectionDetail[] = []
  const outgoing: NeuronConnectionDetail[] = []

  if (neuron.layer > 0) {
    const previousLayer = neuron.layer - 1

    for (let i = 0; i < layerCounts[previousLayer]; i++) {
      const sourceId = layerStarts[previousLayer] + i
      const weight = Number(
        (Math.sin((sourceId + 1) * (neuron.id + 2)) * 0.8).toFixed(3),
      )
      const inputValue = Number(
        ((sourceId + 2) / (layerCounts[previousLayer] + 2)).toFixed(3),
      )

      incoming.push({
        neuronId: sourceId,
        neuronLabel: `Neuron ${sourceId + 1}`,
        weight,
        inputValue,
        contribution: Number((weight * inputValue).toFixed(3)),
      })
    }
  }

  if (neuron.layer < layerCounts.length - 1) {
    const nextLayer = neuron.layer + 1

    for (let i = 0; i < layerCounts[nextLayer]; i++) {
      const targetId = layerStarts[nextLayer] + i

      outgoing.push({
        neuronId: targetId,
        neuronLabel: `Neuron ${targetId + 1}`,
        weight: Number(
          (Math.sin((neuron.id + 1) * (targetId + 2)) * 0.8).toFixed(3),
        ),
        inputValue: 0,
        contribution: 0,
      })
    }
  }

  const bias = Number((Math.cos(neuron.id + 1) * 0.2).toFixed(3))
  const weightedSum = Number(
    (incoming.reduce((sum, item) => sum + item.contribution, 0) + bias).toFixed(3),
  )
  const activation = neuron.layer === 0
    ? Number((0.2 + (neuron.index % 4) * 0.2).toFixed(3))
    : Number(Math.max(0, weightedSum).toFixed(3))

  return { incoming, outgoing, bias, weightedSum, activation }
}

