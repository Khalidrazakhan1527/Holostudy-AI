                            <span style={{ fontSize: 12, lineHeight: 1.6, color: '#a9c4d9' }}>{value}</span>
                          </div>
                        ))}
                      </>
                    ) : selectedModel === 'Computer Architecture' ? (
                      <>
                        {[
                          ['CPU', 'Executes instructions and coordinates processing'],
                          ['ALU', 'Performs arithmetic and logical operations'],
                          ['Control unit', 'Coordinates instruction execution'],
                          ['Registers', 'Provide small, fast storage inside the processor'],
                          ['Memory', 'Stores instructions and data for active tasks'],
                          ['Input / output', 'Moves information between the computer and external devices'],
                          ['Instruction cycle', 'Fetch, decode, execute and store results'],
                        ].map(([label, value]) => (
                          <div key={label} style={{ padding: '11px 0', borderBottom: '1px solid rgba(115,205,255,0.15)' }}>
