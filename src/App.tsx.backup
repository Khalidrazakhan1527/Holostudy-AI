                          </p>
                        </div>

                        <div style={{ marginTop: 16 }}>
                          <h3 style={{ fontSize: 14, margin: '0 0 8px' }}>Shell distribution</h3>
                          <div style={{ display: 'flex', flexWrap: 'wrap', gap: 7 }}>
                            {selectedElement.shells.map((count, index) => (
                              <span key={index} style={{ padding: '7px 10px', borderRadius: 8, border: '1px solid rgba(93,205,255,0.25)', fontSize: 12 }}>
                                {['K','L','M','N','O','P','Q'][index] ?? `Shell ${index + 1}`}: {count}
                              </span>
                            ))}
                          </div>
                        </div>

