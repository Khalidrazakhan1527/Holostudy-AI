                    <option value="default">Default</option>
                    <option value="wide">Wide</option>
                  </select>

                  <label htmlFor="inspector-text-size">Text size</label>
                  <select
                    id="inspector-text-size"
                    value={inspectorTextSize}
                    onChange={(event) => setInspectorTextSize(event.target.value as 'small' | 'medium' | 'large')}
                  >
                    <option value="small">Small</option>
                    <option value="medium">Medium</option>
                    <option value="large">Large</option>
                  </select>

                  <label className="inspector-detail-toggle">
                    <input
                      type="checkbox"
                      checked={showDetailedProperties}
                      onChange={(event) => setShowDetailedProperties(event.target.checked)}
                    />
                    <span>Show detailed properties</span>
                  </label>
                </section>
              )}

              <div className="model-preview-icon">
                <div className="preview-icon-inner">
                  <currentModel.icon size={32} strokeWidth={1.5} />
                </div>
                <div className="preview-model-name">
                  <strong>{currentModel.name}</strong>
                  <span>{currentModel.category}</span>
                </div>
              </div>

              <p className="model-description">{currentModel.description}</p>

              <div className="panel-divider" />

              {selectedModel === 'Atomic Structure' ? (
                <>
                  <section className="atomic-electron-inspector" style={{ marginBottom: 18 }}>
                    <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 8, marginBottom: 12 }}>
                      <div className="property-section-title" style={{ margin: 0 }}>
                        <span>{selectedElectron ? 'SELECTED ELECTRON' : 'ELECTRON INSPECTOR'}</span>
                      </div>
                      <button
                        type="button"
                        className="icon-button"
                        title="Open electron details full screen"
                        aria-label="Open electron details full screen"
                        onClick={() => setAtomicInspectorFullscreen(true)}
                      >
                        <Maximize2 size={16} />
                      </button>
                    </div>
                    {selectedElectron ? (
                      <>
                        <div className="property-row">
                          <span>Particle</span>
                          <strong className="property-value">Electron (e⁻)</strong>
                        </div>
                        <div className="property-row">
                          <span>Electron number</span>
                          <strong className="property-value">{selectedElectron.number}</strong>
                        </div>
                        <div className="property-row">
                          <span>Shell / energy level</span>
                          <strong className="property-value">{selectedElectron.shell}</strong>
                        </div>
                        <div className="property-row">
                          <span>Electric charge</span>
                          <strong className="property-value">−1 e</strong>
                        </div>
                        <div className="property-row">
                          <span>Charge (coulombs)</span>
                          <strong className="property-value">−1.602 × 10⁻¹⁹ C</strong>
                        </div>
                        <div className="property-row">
                          <span>Rest mass</span>
                          <strong className="property-value">9.109 × 10⁻³¹ kg</strong>
                        </div>
                        <p style={{ fontSize: 12, lineHeight: 1.6, opacity: 0.78, marginTop: 10 }}>
                          This electron is shown in shell {selectedElectron.shell} of {selectedElement.name} ({selectedElement.symbol}).
                          The shell is a simplified energy-level representation, not a literal fixed electron path.
                        </p>
                      </>
                    ) : (
                      <p style={{ fontSize: 12, lineHeight: 1.6, opacity: 0.78, margin: 0 }}>
                        Click a glowing electron in the 3D atom to inspect its particle properties here.
                      </p>
                    )}
                  </section>

                  {atomicInspectorFullscreen && (
                    <div
                      role="dialog"
                      aria-modal="true"
                      aria-labelledby="atomic-electron-fullscreen-title"
                      style={{
                        position: 'fixed',
                        inset: 0,
                        zIndex: 9999,
                        background: 'rgba(5, 12, 25, 0.96)',
                        color: '#eef7ff',
                        padding: 'clamp(20px, 5vw, 64px)',
                        overflowY: 'auto',
                      }}
                    >
                      <div style={{ maxWidth: 900, margin: '0 auto' }}>
                        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 16, marginBottom: 28 }}>
                          <div>
                            <span style={{ fontSize: 11, letterSpacing: 2, opacity: 0.7 }}>HOLOSTUDY AI · ATOMIC INSPECTOR</span>
                            <h2 id="atomic-electron-fullscreen-title" style={{ margin: '8px 0 0' }}>
                              {selectedElectron ? `Electron ${selectedElectron.number} · Shell ${selectedElectron.shell}` : 'Electron Details'}
                            </h2>
                          </div>
                          <button
                            type="button"
                            className="icon-button"
                            title="Close full screen"
                            aria-label="Close full screen"
                            onClick={() => setAtomicInspectorFullscreen(false)}
                          >
                            <Minimize2 size={18} />
                          </button>
                        </div>

                        {selectedElectron ? (
                          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))', gap: 14 }}>
                            {[
                              ['Particle type', 'Electron (e⁻)'],
                              ['Element', `${selectedElement.name} (${selectedElement.symbol})`],
                              ['Electron number', String(selectedElectron.number)],
                              ['Shell / energy level', String(selectedElectron.shell)],
                              ['Electric charge', '−1 elementary charge'],
                              ['Charge in coulombs', '−1.602 × 10⁻¹⁹ C'],
                              ['Rest mass', '9.109 × 10⁻³¹ kg'],
                              ['Atomic number', String(selectedElement.atomicNumber)],
                              ['Neutral atom electrons', String(selectedElement.atomicNumber)],
                            ].map(([label, value]) => (
                              <div key={label} style={{ padding: 18, border: '1px solid rgba(115, 205, 255, 0.24)', borderRadius: 12, background: 'rgba(66, 207, 255, 0.06)' }}>
                                <div style={{ fontSize: 12, opacity: 0.7, marginBottom: 8 }}>{label}</div>
                                <strong style={{ fontSize: 16 }}>{value}</strong>
                              </div>
                            ))}
                            <p style={{ gridColumn: '1 / -1', lineHeight: 1.7, opacity: 0.8 }}>
                              Electrons are negatively charged subatomic particles. Shell numbers are simplified energy-level labels in this visualization; actual electrons are described by quantum states rather than classical circular paths.
                            </p>
                          </div>
                        ) : (
                          <p>Close this view, then click an electron in the 3D atom to see its details.</p>
                        )}
                      </div>
                    </div>
                  )}

                  {showDetailedProperties && <>
                  <div className="property-section-title">
                    <span>ELEMENT PROPERTIES</span>
                    <span className="property-count">06</span>
                  </div>

                  <div className="atomic-inspector-element">
                    <span className="atomic-inspector-symbol">{selectedElement.symbol}</span>
                    <div>
                      <strong>{selectedElement.name}</strong>
                      <span>{selectedElement.category}</span>
                    </div>
                  </div>

                  <div className="property-row">
                    <span>Atomic number / Protons</span>
                    <strong className="property-value">{selectedElement.atomicNumber}</strong>
                  </div>
                  <div className="property-row">
                    <span>Atomic mass</span>
                    <strong className="property-value">
                      {selectedElement.atomicMass ?? 'Unknown'} u
                    </strong>
                  </div>
                  <div className="property-row">
                    <span>Mass number (isotope)</span>
                    <strong className="property-value">
                      {selectedElement.commonMassNumber ?? 'Not specified'}
                    </strong>
                  </div>
                  <div className="property-row">
                    <span>Neutrons (selected isotope)</span>
                    <strong className="property-value">
                      {selectedElement.commonMassNumber === null
                        ? 'Not specified'
                        : selectedElement.commonMassNumber - selectedElement.atomicNumber}
                    </strong>
                  </div>
                  <div className="property-row">
                    <span>Electrons (neutral atom)</span>
                    <strong className="property-value">{selectedElement.atomicNumber}</strong>
                  </div>
                  <div className="property-row">
                    <span>Period / Group</span>
                    <strong className="property-value">
                      {selectedElement.period} / {selectedElement.group ?? '—'}
                    </strong>
                  </div>

                  <details className="atomic-inspector-info">
                    <summary>Element Info &amp; Electron Configuration</summary>
                    <div className="atomic-inspector-info-body">
                      <span>Symbol</span>
                      <strong>{selectedElement.symbol}</strong>
                      <span>Electron configuration</span>
                      <code>{selectedElement.electronConfiguration}</code>
                      <span>Shell distribution</span>
                      <code>{selectedElement.shells.join(' · ') || 'Unavailable'}</code>
                      <p>
                        Atomic mass is the standard atomic weight where available.
                        Mass number identifies a particular isotope.
                      </p>
                    </div>
                  </details>
                  </>}
                </>
              ) : (
                <>
                  {showDetailedProperties && <>
                  <div className="property-section-title">
                    <span>MODEL PROPERTIES</span>
                    <span className="property-count">03</span>
                  </div>

                  <div className="property-row">
                    <span>Representation</span>
                    <span className="property-value">3D Preview</span>
                  </div>
                  <div className="property-row">
                    <span>Labels</span>
                    <span className={`property-value ${showLabels ? 'value-enabled' : ''}`}>
                      {showLabels ? 'Enabled' : 'Hidden'}
                    </span>
                  </div>
                  <div className="property-row">
                    <span>Interaction</span>
                    <span className="property-value value-enabled">
                      {selectedModel === 'Neural Network' ? 'Interactive' : 'Coming soon'}
                    </span>
                  </div>

                  <div className="property-row">
                    <span>Selected neuron</span>
                    <span className="property-value">
                      {selectedNeuron ? `N${selectedNeuron.id + 1}` : 'None'}
                    </span>
                  </div>
                  </>}
                </>
              )}

              {showDetailedProperties && selectedNeuron && selectedModel === 'Neural Network' && neuronDetails && (
                <div className="selected-neuron-card neuron-inspector">
                  <div className="neuron-inspector-heading">
                    <div>
                      <span className="section-eyebrow">NEURON INSPECTOR · DEMO DATA</span>
                      <h3>{selectedNeuron.label}</h3>
                      <p>Layer {selectedNeuron.layer + 1} · Position {selectedNeuron.index + 1}</p>
                    </div>
                    <button
                      className="neuron-expand-button"
                      onClick={() => setInspectorFullscreen(true)}
                    >
                      <Maximize2 size={16} />
                      <span>Expand Inspector</span>
                    </button>
                  </div>

                  <div className="neuron-inspector-metrics">
                    <div><span>INCOMING</span><strong>{neuronDetails.incoming.length}</strong></div>
                    <div><span>OUTGOING</span><strong>{neuronDetails.outgoing.length}</strong></div>
                    <div><span>ACTIVATION</span><strong>{neuronDetails.activation.toFixed(3)}</strong></div>
                  </div>

                  <div className="neuron-inspector-section">
                    <strong>Computation</strong>
                    <div className="neuron-detail-row"><span>Bias</span><code>{neuronDetails.bias.toFixed(3)}</code></div>
                    <div className="neuron-detail-row"><span>Weighted sum (z)</span><code>{neuronDetails.weightedSum.toFixed(3)}</code></div>
                    <div className="neuron-detail-row"><span>Activation function</span><code>{selectedNeuron.layer === 0 ? 'Input' : 'ReLU'}</code></div>
                  </div>

                  <div className="neuron-inspector-section">
                    <strong>Incoming connections</strong>
                    {neuronDetails.incoming.length === 0 ? (
                      <p className="neuron-inspector-note">Input-layer neuron: no previous-layer connections.</p>
                    ) : neuronDetails.incoming.map((item) => (
                      <div className="neuron-connection-row" key={item.neuronId}>
                        <div><strong>{item.neuronLabel}</strong><span>Input {item.inputValue.toFixed(3)}</span></div>
                        <div><code>Weight {item.weight.toFixed(3)}</code><code>Contribution {item.contribution.toFixed(3)}</code></div>
                      </div>
                    ))}
                  </div>

                  <div className="neuron-inspector-section">
                    <strong>Outgoing connections</strong>
                    {neuronDetails.outgoing.length === 0 ? (
                      <p className="neuron-inspector-note">Output-layer neuron: no next-layer connections.</p>
                    ) : neuronDetails.outgoing.map((item) => (
                      <div className="neuron-connection-row" key={item.neuronId}>
                        <div><strong>{item.neuronLabel}</strong><span>Outgoing connection</span></div>
                        <code>Weight {item.weight.toFixed(3)}</code>
                      </div>
                    ))}
                  </div>

                  <p className="neuron-inspector-note">
                    Illustrative demo calculations—not trained model parameters or real inference.
                  </p>

                  <button className="neuron-clear-button" onClick={() => setSelectedNeuron(null)}>
                    Clear selection
                  </button>
                </div>
              )}

              {inspectorFullscreen && selectedNeuron && neuronDetails && (
                <div className="neuron-fullscreen-overlay" role="dialog" aria-modal="true" aria-labelledby="neuron-fullscreen-title">
                  <div className="neuron-fullscreen-header">
                    <div>
                      <span className="section-eyebrow">HOLOSTUDY AI · NEURON EXPLORER</span>
                      <h2 id="neuron-fullscreen-title">{selectedNeuron.label}</h2>
                      <p>Layer {selectedNeuron.layer + 1} · Position {selectedNeuron.index + 1} · Demo data</p>
                    </div>
                    <button className="neuron-close-fullscreen" onClick={() => setInspectorFullscreen(false)}>
                      <Minimize2 size={17} />
                      <span>Exit full screen</span>
                    </button>
                  </div>

                  <div className="neuron-fullscreen-content">
                    <div className="neuron-inspector-metrics">
                      <div><span>INCOMING</span><strong>{neuronDetails.incoming.length}</strong></div>
                      <div><span>OUTGOING</span><strong>{neuronDetails.outgoing.length}</strong></div>
                      <div><span>ACTIVATION</span><strong>{neuronDetails.activation.toFixed(3)}</strong></div>
                    </div>

                    <section className="neuron-inspector-section">
                      <h3>Computation</h3>
                      <div className="neuron-detail-row"><span>Bias</span><code>{neuronDetails.bias.toFixed(3)}</code></div>
                      <div className="neuron-detail-row"><span>Weighted sum (z)</span><code>{neuronDetails.weightedSum.toFixed(3)}</code></div>
                      <div className="neuron-detail-row"><span>Activation function</span><code>{selectedNeuron.layer === 0 ? 'Input' : 'ReLU'}</code></div>
                      <p className="neuron-inspector-note">Weighted sum = sum of (input × weight) + bias.</p>
                    </section>

                    <div className="neuron-fullscreen-columns">
                      <section className="neuron-inspector-section">
                        <h3>Incoming connections ({neuronDetails.incoming.length})</h3>
                        {neuronDetails.incoming.length === 0 ? (
                          <p className="neuron-inspector-note">No previous-layer connections.</p>
                        ) : neuronDetails.incoming.map((item) => (
                          <div className="neuron-connection-row" key={item.neuronId}>
                            <div><strong>{item.neuronLabel}</strong><span>Input {item.inputValue.toFixed(3)}</span></div>
                            <div><code>Weight {item.weight.toFixed(3)}</code><code>Contribution {item.contribution.toFixed(3)}</code></div>
                          </div>
                        ))}
                      </section>

                      <section className="neuron-inspector-section">
                        <h3>Outgoing connections ({neuronDetails.outgoing.length})</h3>
                        {neuronDetails.outgoing.length === 0 ? (
                          <p className="neuron-inspector-note">No next-layer connections.</p>
                        ) : neuronDetails.outgoing.map((item) => (
                          <div className="neuron-connection-row" key={item.neuronId}>
                            <div><strong>{item.neuronLabel}</strong><span>Outgoing connection</span></div>
                            <code>Weight {item.weight.toFixed(3)}</code>
                          </div>
                        ))}
                      </section>
                    </div>

                    <p className="neuron-inspector-note neuron-demo-warning">
                      Illustrative demo calculations—not trained model parameters or real inference.
                    </p>
                  </div>
                </div>
              )}

              <div className="panel-divider" />

              <div className="property-section-title">
                <span>AVAILABLE ACTIONS</span>
              </div>

              <button className="action-row" onClick={() => setShowLabels(!showLabels)}>
                <div className="action-icon"><Eye size={16} /></div>
                <div><strong>{showLabels ? 'Hide labels' : 'Show labels'}</strong><span>Toggle model annotations</span></div>
                <ChevronDown className="action-chevron" size={15} />
              </button>

              <button
                className="action-row"
                onClick={() => {
                  setSelectedModel('Neural Network')
                  setShowLabels(true)
                  setSelectedNeuron(null)
                }}
              >
                <div className="action-icon"><Rotate3D size={16} /></div>
                <div><strong>Reset workspace</strong><span>Restore initial selection</span></div>
              </button>

              <button
                className="primary-action"
                onClick={() => choosePage('What-If Lab')}
              >
                <FlaskConical size={17} />
                Open What-If Lab
                <span>→</span>
              </button>
            </aside>
          </section>


          {inspectorDetailFullscreen && (
            <div
              role="dialog"
              aria-modal="true"
              aria-labelledby="model-details-fullscreen-title"
              style={{
                position: 'fixed',
                inset: 0,
                zIndex: 10000,
                overflowY: 'auto',
                background: '#07101f',
                color: '#e8f4ff',
                padding: 'clamp(16px, 3vw, 40px)',
                boxSizing: 'border-box',
              }}
            >
              <div style={{ maxWidth: 1180, margin: '0 auto' }}>
                <header style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  alignItems: 'center',
                  gap: 16,
                  marginBottom: 28,
                  paddingBottom: 20,
                  borderBottom: '1px solid rgba(125, 211, 252, 0.2)',
                }}>
                  <div>
                    <div className="section-eyebrow">HOLOSTUDY AI · MODEL DETAILS · FULLSCREEN EXPLORER</div>
                    <h1 id="model-details-fullscreen-title" style={{ fontSize: 'clamp(25px, 4vw, 38px)', margin: '10px 0 6px' }}>
                      {selectedModel}
                    </h1>
                    <p style={{ margin: 0, opacity: 0.72, lineHeight: 1.6 }}>
                      {currentModel.description}
                    </p>
                  </div>
                  <button
                    type="button"
                    className="icon-button"
                    title="Close fullscreen details"
                    aria-label="Close fullscreen details"
                    onClick={() => setInspectorDetailFullscreen(false)}
                  >
                    <Minimize2 size={19} />
                  </button>
                </header>

                {selectedModel === 'Atomic Structure' ? (
                  <>
                    <div style={{
                      display: 'grid',
                      gridTemplateColumns: 'repeat(auto-fit, minmax(160px, 1fr))',
                      gap: 12,
                      marginBottom: 22,
                    }}>
                      {[
                        ['ELEMENT', `${selectedElement.name} (${selectedElement.symbol})`],
                        ['ATOMIC NUMBER', String(selectedElement.atomicNumber)],
                        ['ATOMIC MASS', `${selectedElement.atomicMass ?? 'Unknown'} u`],
                        ['ION CHARGE', `${ionCharge > 0 ? '+' : ''}${ionCharge}`],
                      ].map(([label, value]) => (
                        <div key={label} style={{
                          padding: 18,
                          border: '1px solid rgba(125, 211, 252, 0.22)',
                          borderRadius: 13,
                          background: 'rgba(56, 189, 248, 0.06)',
                        }}>
                          <div style={{ fontSize: 11, letterSpacing: 1.3, opacity: 0.65, marginBottom: 9 }}>{label}</div>
                          <strong style={{ fontSize: 18 }}>{value}</strong>
                        </div>
                      ))}
                    </div>

                    {([
                      {
                        id: 'element-properties',
                        title: 'Element properties',
                        summary: 'Identity, classification and periodic-table position.',
                        rows: [
                          ['Element name', selectedElement.name],
                          ['Chemical symbol', selectedElement.symbol],
                          ['Category', selectedElement.category],
                          ['Atomic number / proton count', String(selectedElement.atomicNumber)],
                          ['Period', String(selectedElement.period)],
                          ['Group', selectedElement.group == null ? 'Not assigned in this dataset' : String(selectedElement.group)],
                          ['Standard atomic mass', `${selectedElement.atomicMass ?? 'Unknown'} u`],
                          ['Reference mass number', selectedElement.commonMassNumber == null ? 'Not specified' : String(selectedElement.commonMassNumber)],
                          ['Estimated neutrons for reference isotope', selectedElement.commonMassNumber == null ? 'Not specified' : String(selectedElement.commonMassNumber - selectedElement.atomicNumber)],
                        ],
                      },
                      {
                        id: 'electronic-configuration',
                        title: 'Electronic configuration',
                        summary: 'Electron configuration and shell distribution in the element dataset.',
                        rows: [
                          ['Neutral-atom configuration', selectedElement.electronConfiguration],
                          ['Shell distribution', selectedElement.shells.join(' · ') || 'Unavailable'],
                          ['Occupied shells in dataset', String(selectedElement.shells.filter((n) => n > 0).length)],
                          ['Neutral atom electron count', String(selectedElement.atomicNumber)],
                          ['Current ion charge', `${ionCharge > 0 ? '+' : ''}${ionCharge}`],
                          ['Estimated ion electron count', String(Math.max(0, selectedElement.atomicNumber - ionCharge))],
                        ],
                      },
                      {
                        id: 'nuclear-structure',
                        title: 'Nuclear structure',
                        summary: 'Protons, isotope reference and neutron interpretation.',
                        rows: [
                          ['Protons', String(selectedElement.atomicNumber)],
                          ['Reference mass number', selectedElement.commonMassNumber == null ? 'Not specified' : String(selectedElement.commonMassNumber)],
                          ['Reference neutron estimate', selectedElement.commonMassNumber == null ? 'Not specified' : String(selectedElement.commonMassNumber - selectedElement.atomicNumber)],
                          ['Isotope note', 'Neutron count depends on the isotope. The displayed mass number is a reference value from this dataset.'],
                        ],
                      },
                      {
                        id: 'chemical-overview',
                        title: 'Chemical overview',
                        summary: 'How to interpret this element’s data.',
                        rows: [
                          ['Classification', selectedElement.category],
                          ['Periodic-table period', String(selectedElement.period)],
                          ['Periodic-table group', selectedElement.group == null ? 'Not assigned in this dataset' : String(selectedElement.group)],
                          ['Atomic mass note', 'Atomic mass is not the same as the mass number of an individual isotope.'],
                          ['Electron model note', 'Shells are a simplified energy-level representation; electrons are described more accurately by quantum states.'],
                        ],
                      },
                    ]).map((section) => {
                      const expanded = expandedInfoSections.includes(section.id)
                      return (
                        <section key={section.id} style={{
                          border: '1px solid rgba(125, 211, 252, 0.2)',
                          borderRadius: 13,
                          marginBottom: 12,
                          overflow: 'hidden',
                          background: 'rgba(15, 31, 51, 0.75)',
                        }}>
                          <button
                            type="button"
                            onClick={() => setExpandedInfoSections((previous) =>
                              previous.includes(section.id)
                                ? previous.filter((id) => id !== section.id)
                                : [...previous, section.id]
                            )}
                            aria-expanded={expanded}
                            style={{
                              width: '100%',
                              display: 'flex',
                              alignItems: 'center',
                              justifyContent: 'space-between',
                              gap: 16,
                              padding: '18px 20px',
                              color: 'inherit',
                              textAlign: 'left',
                              border: 0,
                              background: 'transparent',
                              cursor: 'pointer',
                            }}
                          >
                            <span>
                              <strong style={{ display: 'block', fontSize: 16 }}>{section.title}</strong>
                              <span style={{ display: 'block', fontSize: 12, opacity: 0.65, marginTop: 5 }}>{section.summary}</span>
                            </span>
                            <span aria-hidden="true" style={{ fontSize: 22, color: '#7dd3fc' }}>{expanded ? '−' : '+'}</span>
                          </button>
                          {expanded && (
                            <div style={{
                              padding: '0 20px 20px',
                              borderTop: '1px solid rgba(125, 211, 252, 0.12)',
                            }}>
                              {section.rows.map(([label, value]) => (
                                <div key={label} style={{
                                  display: 'grid',
                                  gridTemplateColumns: 'minmax(130px, 0.8fr) minmax(0, 1.2fr)',
                                  gap: 14,
                                  padding: '12px 0',
                                  borderBottom: '1px solid rgba(125, 211, 252, 0.09)',
                                  lineHeight: 1.6,
                                }}>
                                  <span style={{ opacity: 0.68, fontSize: 13 }}>{label}</span>
                                  <strong style={{ fontSize: 13, fontWeight: 500, overflowWrap: 'anywhere' }}>{value}</strong>
                                </div>
                              ))}
                            </div>
                          )}
                        </section>
                      )
                    })}
                  </>
                ) : (
                  <>
                    <div style={{
                      display: 'grid',
                      gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))',
                      gap: 14,
                      marginBottom: 22,
                    }}>
                      {[
                        ['Model', selectedModel],
                        ['Category', currentModel.category],
                        ['Representation', 'Interactive 3D preview'],
                        ['Labels', showLabels ? 'Enabled' : 'Hidden'],
                        ['Simulation', atomicSimulationOn ? 'Running' : 'Paused'],
                      ].map(([label, value]) => (
                        <div key={label} style={{
                          padding: 18,
                          border: '1px solid rgba(125, 211, 252, 0.22)',
                          borderRadius: 13,
                          background: 'rgba(56, 189, 248, 0.06)',
                        }}>
                          <div style={{ fontSize: 11, letterSpacing: 1.2, opacity: 0.65, marginBottom: 9 }}>{label}</div>
                          <strong style={{ fontSize: 17 }}>{value}</strong>
                        </div>
                      ))}
                    </div>

                    {([
                      {
                        id: 'model-overview',
                        title: 'Model overview',
                        summary: 'Purpose and interpretation of the selected visualization.',
                        rows: [
                          ['Model', selectedModel],
                          ['Category', currentModel.category],
                          ['Description', currentModel.description],
                          ['Representation', 'Interactive 3D educational visualization'],
                          ['Label visibility', showLabels ? 'Enabled' : 'Hidden'],
                        ],
                      },
                      {
                        id: 'model-architecture',
                        title: selectedModel === 'Neural Network' ? 'Network architecture' : 'Structure and components',
                        summary: 'Main parts and their roles in the represented system.',
                        rows: selectedModel === 'Neural Network'
                          ? [
                              ['Input layer', 'Receives the feature values supplied to the network.'],
                              ['Hidden layers', 'Transform representations through weighted connections and activation functions.'],
                              ['Output layer', 'Produces the network output or prediction representation.'],
                              ['Weights', 'Parameters that scale signals between connected neurons.'],
                              ['Biases', 'Learnable offsets added to weighted sums.'],
                              ['Activation', 'Nonlinear function applied to a neuron’s weighted sum.'],
                            ]
                          : [
                              ['Primary structure', 'Explore the visible components in the 3D viewer.'],
                              ['Components', 'Select or inspect available parts where interactions are supported.'],
                              ['Visualization', 'The displayed model is an educational representation.'],
                            ],
                      },
                      {
                        id: 'model-interactions',
                        title: 'Interaction and simulation',
                        summary: 'Available controls and interpretation of the current view.',
                        rows: [
                          ['3D navigation', 'Use the viewer controls to rotate or zoom the model.'],
                          ['Labels', showLabels ? 'Currently enabled' : 'Currently hidden'],
                          ['Simulation control', 'Use the viewer play/pause control where supported.'],
                          ['Selected neuron', selectedModel === 'Neural Network' && selectedNeuron ? selectedNeuron.label : 'No neuron selected'],
                          ['Data limitation', 'Only data explicitly displayed by this prototype should be treated as measured or computed output.'],
                        ],
                      },
                    ]).map((section) => {
                      const expanded = expandedInfoSections.includes(section.id)
                      return (
                        <section key={section.id} style={{
                          border: '1px solid rgba(125, 211, 252, 0.2)',
                          borderRadius: 13,
                          marginBottom: 12,
                          overflow: 'hidden',
                          background: 'rgba(15, 31, 51, 0.75)',
                        }}>
                          <button
                            type="button"
                            onClick={() => setExpandedInfoSections((previous) =>
                              previous.includes(section.id)
                                ? previous.filter((id) => id !== section.id)
                                : [...previous, section.id]
                            )}
                            aria-expanded={expanded}
                            style={{
                              width: '100%',
                              display: 'flex',
                              alignItems: 'center',
                              justifyContent: 'space-between',
                              gap: 16,
                              padding: '18px 20px',
                              color: 'inherit',
                              textAlign: 'left',
                              border: 0,
                              background: 'transparent',
                              cursor: 'pointer',
                            }}
                          >
                            <span>
                              <strong style={{ display: 'block', fontSize: 16 }}>{section.title}</strong>
                              <span style={{ display: 'block', fontSize: 12, opacity: 0.65, marginTop: 5 }}>{section.summary}</span>
                            </span>
                            <span aria-hidden="true" style={{ fontSize: 22, color: '#7dd3fc' }}>{expanded ? '−' : '+'}</span>
                          </button>
                          {expanded && (
                            <div style={{ padding: '0 20px 20px', borderTop: '1px solid rgba(125, 211, 252, 0.12)' }}>
                              {section.rows.map(([label, value]) => (
                                <div key={label} style={{
                                  display: 'grid',
                                  gridTemplateColumns: 'minmax(130px, 0.8fr) minmax(0, 1.2fr)',
                                  gap: 14,
                                  padding: '12px 0',
                                  borderBottom: '1px solid rgba(125, 211, 252, 0.09)',
                                  lineHeight: 1.6,
                                }}>
                                  <span style={{ opacity: 0.68, fontSize: 13 }}>{label}</span>
                                  <strong style={{ fontSize: 13, fontWeight: 500, overflowWrap: 'anywhere' }}>{value}</strong>
                                </div>
                              ))}
                            </div>
                          )}
                        </section>
                      )
                    })}
                  </>
                )}

                <footer style={{ marginTop: 24, opacity: 0.6, fontSize: 12, lineHeight: 1.6 }}>
                  Educational visualization · Values and explanations depend on the selected model and the data available in this prototype.
                </footer>
              </div>
            </div>
          )}

          <section className="library-section">
            <div className="library-heading">
              <div>
                <div className="section-eyebrow">START LEARNING</div>
                <h2>Explore concepts</h2>
              </div>
              <span className="library-count">{filteredModels.length} MODELS</span>
            </div>

            <div className="model-cards">
              {filteredModels.map((model, index) => {
                const Icon = model.icon
                return (
                  <button
                    key={model.name}
                    className={`model-card ${selectedModel === model.name ? 'model-card-selected' : ''}`}
                    onClick={() => {
                      setSelectedModel(model.name)
                      setActivePage('Dashboard')
                    }}
                  >
                    <div className={`model-card-icon model-icon-${index}`}>
                      <Icon size={23} strokeWidth={1.7} />
                    </div>
                    <div className="model-card-info">
                      <span>{model.category}</span>
                      <strong>{model.name}</strong>
                      <p>{model.description}</p>
                    </div>
                    <div className="model-card-arrow">↗</div>
                  </button>
                )
              })}
              {filteredModels.length === 0 && (
                <div className="no-results">
                  No models match “{search}”. Try another search.
                </div>
              )}
              <button className="model-card add-model-card" onClick={() => document.getElementById('model-upload')?.click()}>
                <div className="add-model-icon"><Plus size={23} /></div>
                <strong>Bring your own</strong>
                <p>Upload a diagram to get started.</p>
              </button>
            </div>
          </section>

          <footer className="page-footer">
            <span>© 2026 HOLOSTUDY AI</span>
            <span><Waves size={13} /> BUILT FOR CURIOUS MINDS</span>
            <span className="footer-version">PREVIEW · V0.1</span>
          </footer>
        </div>
      </section>

      <div className="mobile-menu-button">
        <button onClick={() => setSidebarOpen(!sidebarOpen)} aria-label="Toggle menu">
          <Menu size={20} />
        </button>
      </div>
    </main>
  )
}

export default App
