import { useState } from 'react'
import NeuralNetwork3D from './components/NeuralNetwork3D'
import AtomicStructure3D from './components/AtomicStructure3D'
import HumanHeart3D from './components/HumanHeart3D'
import ComputerArchitecture3D from './components/ComputerArchitecture3D'
import { ELEMENTS } from './data/elements'
import {
  Activity,
  Atom,
  BrainCircuit,
  ChevronDown,
  CircleHelp,
  Cpu,
  Eye,
  Info,
  FileImage,
  FlaskConical,
  Layers3,
  Menu,
  Maximize2,
  Minimize2,
  Network,
  PanelLeftClose,
  Plus,
  Rotate3D,
  Search,
  Settings2,
  ShieldCheck,
  Sparkles,
  Upload,
  Waves,
  ZoomIn,
  ZoomOut,
  Bell,
  Command,
} from 'lucide-react'
import './App.css'

type Model = {
  name: string
  category: string
  description: string
  icon: typeof BrainCircuit
}

const models: Model[] = [
  {
    name: 'Neural Network',
    category: 'ARTIFICIAL INTELLIGENCE',
    description: 'Explore neurons, layers and information flow.',
    icon: BrainCircuit,
  },
  {
    name: 'Atomic Structure',
    category: 'CHEMISTRY',
    description: 'Explore protons, neutrons and electrons.',
    icon: Atom,
  },
  {
    name: 'Human Heart',
    category: 'BIOLOGY',
    description: 'Discover the structures of the human heart.',
    icon: Activity,
  },
  {
    name: 'Computer Architecture',
    category: 'COMPUTER SCIENCE',
    description: 'Understand the components of a computer.',
    icon: Cpu,
  },
]

type SelectedNeuron = {
  id: number
  layer: number
  index: number
  position: [number, number, number]
  label: string
}

type NeuronConnectionDetail = {
  neuronId: number
  neuronLabel: string
  weight: number
  inputValue: number
  contribution: number
}

function getNeuronConnectionDetails(neuron: SelectedNeuron) {
  const layerCounts = [4, 5, 4, 3]
  const layerStarts = [0, 4, 9, 13]

  const incoming: NeuronConnectionDetail[] = []
  const outgoing: NeuronConnectionDetail[] = []

  if (neuron.layer > 0) {
    const previousLayer = neuron.layer - 1

    for (let i = 0; i < layerCounts[previousLayer]; i++) {
      const sourceId = layerStarts[previousLayer] + i
      const weight = Number(
        (Math.sin((sourceId + 1) * (neuron.id + 2)) * 0.8).toFixed(3),
      )
      const inputValue = Number(
        ((sourceId + 2) / (layerCounts[previousLayer] + 2)).toFixed(3),
      )

      incoming.push({
        neuronId: sourceId,
        neuronLabel: `Neuron ${sourceId + 1}`,
        weight,
        inputValue,
        contribution: Number((weight * inputValue).toFixed(3)),
      })
    }
  }

  if (neuron.layer < layerCounts.length - 1) {
    const nextLayer = neuron.layer + 1

    for (let i = 0; i < layerCounts[nextLayer]; i++) {
      const targetId = layerStarts[nextLayer] + i

      outgoing.push({
        neuronId: targetId,
        neuronLabel: `Neuron ${targetId + 1}`,
        weight: Number(
          (Math.sin((neuron.id + 1) * (targetId + 2)) * 0.8).toFixed(3),
        ),
        inputValue: 0,
        contribution: 0,
      })
    }
  }

  const bias = Number((Math.cos(neuron.id + 1) * 0.2).toFixed(3))
  const weightedSum = Number(
    (incoming.reduce((sum, item) => sum + item.contribution, 0) + bias).toFixed(3),
  )
  const activation = neuron.layer === 0
    ? Number((0.2 + (neuron.index % 4) * 0.2).toFixed(3))
    : Number(Math.max(0, weightedSum).toFixed(3))

  return { incoming, outgoing, bias, weightedSum, activation }
}

function App() {
  const [selectedNeuron, setSelectedNeuron] = useState<SelectedNeuron | null>(null)
  const [zoomCommand, setZoomCommand] = useState<{ direction: 'in' | 'out'; id: number } | null>(null)
  const [showViewerSettings, setShowViewerSettings] = useState(false)
  const [inspectorFullscreen, setInspectorFullscreen] = useState(false)
  const [selectedElectron, setSelectedElectron] = useState<{
    id: string
    shell: number
    number: number
  } | null>(null)
  const [atomicInspectorFullscreen, setAtomicInspectorFullscreen] = useState(false)

  const neuronDetails = selectedNeuron
    ? getNeuronConnectionDetails(selectedNeuron)
    : null
  const [activePage, setActivePage] = useState('Dashboard')
  const [selectedModel, setSelectedModel] = useState('Neural Network')
  const [showModelInformation, setShowModelInformation] = useState(false)
  const [inspectorDetailFullscreen, setInspectorDetailFullscreen] = useState(false)
  const [expandedInfoSections, setExpandedInfoSections] = useState<string[]>([
    'element-properties',
    'electronic-configuration',
  ])
  const [selectedElementNumber, setSelectedElementNumber] = useState(6)
  const [showElementPicker, setShowElementPicker] = useState(false)
  const [pendingElementNumber, setPendingElementNumber] = useState(6)
  const [showInspectorSettings, setShowInspectorSettings] = useState(false)
  const [inspectorWidth, setInspectorWidth] = useState<'compact' | 'default' | 'wide'>('default')
  const [inspectorTextSize, setInspectorTextSize] = useState<'small' | 'medium' | 'large'>('medium')
  const [showDetailedProperties, setShowDetailedProperties] = useState(true)
  const [ionCharge, setIonCharge] = useState(0)
  const selectedElement = ELEMENTS.find((element) => element.atomicNumber === selectedElementNumber) ?? ELEMENTS[5]
  const [search, setSearch] = useState('')
  const [showLabels, setShowLabels] = useState(true)
  const [autoRotate, setAutoRotate] = useState(false)
  const [atomicSimulationOn, setAtomicSimulationOn] = useState(false)
  const [viewerDisplayMode, setViewerDisplayMode] = useState<'default' | 'dark' | 'glass'>('default')
  const [rotationCommand, setRotationCommand] = useState<{ direction: 'left' | 'right' | 'up' | 'down' | 'full' | 'reset'; id: number } | null>(null)
  const [sidebarOpen, setSidebarOpen] = useState(true)
  const [showModelMenu, setShowModelMenu] = useState(false)
  const [isFullscreen, setIsFullscreen] = useState(false)
  const [fullscreenElement, setFullscreenElement] = useState<HTMLDivElement | null>(null)

  useState(() => {
    const syncFullscreen = () => setIsFullscreen(Boolean(document.fullscreenElement))
    document.addEventListener('fullscreenchange', syncFullscreen)
    return () => document.removeEventListener('fullscreenchange', syncFullscreen)
  })

  const currentModel =
    models.find((model) => model.name === selectedModel) ?? models[0]

  const filteredModels = models.filter((model) =>
    model.name.toLowerCase().includes(search.toLowerCase()),
  )

  const navigation = [
    { label: 'Dashboard', icon: Layers3 },
    { label: 'Explore Models', icon: Network },
    { label: 'My Models', icon: FileImage },
    { label: 'What-If Lab', icon: FlaskConical },
  ]

  function choosePage(page: string) {
    setActivePage(page)
    if (page === 'Explore Models') {
      setShowModelMenu(true)
    }
  }

  return (
    <main className="app-shell">
      <aside className={`sidebar ${sidebarOpen ? '' : 'sidebar-collapsed'}`}>
        <div className="brand">
          <div className="brand-mark">
            <BrainCircuit size={25} strokeWidth={1.8} />
            <span className="brand-spark">✦</span>
          </div>
          {sidebarOpen && (
            <div className="brand-copy">
              <span className="brand-name">HoloStudy<span> AI</span></span>
              <span className="brand-caption">VISUAL LEARNING STUDIO</span>
            </div>
          )}
          <button
            className="icon-button sidebar-toggle"
            onClick={() => setSidebarOpen(!sidebarOpen)}
            title="Toggle sidebar"
          >
            <PanelLeftClose size={17} />
          </button>
        </div>

        {sidebarOpen && <div className="workspace-label">WORKSPACE</div>}

        <nav className="side-navigation">
          {navigation.map(({ label, icon: Icon }) => (
            <button
              key={label}
              className={`nav-item ${activePage === label ? 'active' : ''}`}
              onClick={() => choosePage(label)}
              title={label}
            >
              <Icon size={19} strokeWidth={1.8} />
              {sidebarOpen && <span>{label}</span>}
              {sidebarOpen && label === 'What-If Lab' && (
                <span className="nav-badge">LAB</span>
              )}
            </button>
          ))}
        </nav>

        {sidebarOpen && (
          <>
            <div className="sidebar-divider" />
            <div className="workspace-label">QUICK ACCESS</div>
            <div className="quick-access">
              <button onClick={() => setSelectedModel('Neural Network')}>
                <span className="quick-dot cyan-dot" />
                Neural Network
                <span className="quick-type">3D</span>
              </button>
              <button onClick={() => setSelectedModel('Atomic Structure')}>
                <span className="quick-dot purple-dot" />
                Atomic Structure
                <span className="quick-type">3D</span>
              </button>
              <button onClick={() => setSelectedModel('Human Heart')}>
                <span className="quick-dot pink-dot" />
                Human Heart
                <span className="quick-type">3D</span>
              </button>
            </div>

            <div className="sidebar-bottom">
              <div className="upgrade-card">
                <div className="upgrade-icon">
                  <Sparkles size={17} />
                </div>
                <strong>Learning, visualized.</strong>
                <p>Turn complex concepts into interactive experiences.</p>
              </div>
              <button className="nav-item">
                <Settings2 size={18} />
                <span>Settings</span>
              </button>
              <button className="nav-item">
                <CircleHelp size={18} />
                <span>Help & Support</span>
              </button>
              <div className="user-card">
                <div className="avatar">K</div>
                <div className="user-info">
                  <strong>Student Workspace</strong>
                  <span>Free workspace</span>
                </div>
                <ChevronDown size={15} />
              </div>
            </div>
          </>
        )}
      </aside>

      <section className="main-area">
        <header className="topbar">
          <div className="breadcrumb">
            <span>Workspace</span>
            <span className="breadcrumb-slash">/</span>
            <strong>{activePage}</strong>
          </div>

          <div className="topbar-actions">
            <label className="global-search">
              <Search size={16} />
              <input
                value={search}
                onChange={(event) => setSearch(event.target.value)}
                placeholder="Search models..."
                aria-label="Search models"
              />
              <kbd><Command size={10} /> K</kbd>
            </label>
            <button className="icon-button notification-button" title="Notifications">
              <Bell size={18} />
              <span />
            </button>
            <div className="top-avatar">K</div>
          </div>
        </header>

        <div className="page-content">
          <section className="welcome-section">
            <div>
              <div className="eyebrow">
                <span className="live-dot" />
                YOUR INTERACTIVE LEARNING SPACE
              </div>
              <h1>Understand the <span>unseen.</span></h1>
              <p className="welcome-description">
                Explore complex concepts in 3D. Interact, experiment, and
                discover how things really work.
              </p>
            </div>
            <button className="upload-button" onClick={() => document.getElementById('model-upload')?.click()}>
              <Upload size={17} />
              Upload a diagram
            </button>
            <input
              id="model-upload"
              type="file"
              accept="image/*,.pdf"
              hidden
              onChange={(event) => {
                const file = event.target.files?.[0]
                if (file) {
                  window.alert(`Selected: ${file.name}. Diagram analysis will be added in a later step.`)
                }
              }}
            />
          </section>

          <section className="stats-row">
            <div className="stat-card">
              <div className="stat-icon cyan-bg"><Network size={19} /></div>
              <div><span>MODEL LIBRARY</span><strong>04 <small>topics</small></strong></div>
              <div className="stat-decoration">◈</div>
            </div>
            <div className="stat-card">
              <div className="stat-icon purple-bg"><Rotate3D size={19} /></div>
              <div><span>3D WORKSPACE</span><strong>Ready <small>to explore</small></strong></div>
              <div className="stat-decoration">⌘</div>
            </div>
            <div className="stat-card">
              <div className="stat-icon green-bg"><ShieldCheck size={19} /></div>
              <div><span>LEARNING MODE</span><strong>Interactive</strong></div>
              <div className="status-pill"><span /> Active</div>
            </div>
          </section>

          <section className="explorer-heading">
            <div>
              <div className="section-eyebrow">YOUR WORKSPACE</div>
              <h2>3D Model Explorer</h2>
              <p>Select a concept to start exploring its structure.</p>
            </div>
            <button className="text-button" onClick={() => choosePage('Explore Models')}>
              Browse library <span>↗</span>
            </button>
          </section>

          <section className="explorer-layout">
            <div className={`viewer-card ${isFullscreen ? "viewer-card-fullscreen" : ""}`} ref={setFullscreenElement}>
              <div className="viewer-toolbar">
                <div className="model-selector-wrap">
                  <button
                    className="model-selector"
                    onClick={() => setShowModelMenu(!showModelMenu)}
                  >
                    <currentModel.icon size={18} />
                    <span>{selectedModel}</span>
                    <ChevronDown size={15} />
                  </button>
                  {showModelMenu && (
                    <div className="model-dropdown">
                      {models.map((model) => {
                        const Icon = model.icon
                        return (
                          <button
                            key={model.name}
                            onClick={() => {
                              setSelectedModel(model.name)
                              setShowModelMenu(false)
                            }}
                          >
                            <Icon size={17} />
                            <span>{model.name}</span>
                          </button>
                        )
                      })}
                    </div>
                  )}
                </div>
                <div className="viewer-tools">
                  <button
                    type="button"
                    className={`viewer-tool ${showModelInformation ? 'tool-active' : ''}`}
                    onClick={() => setShowModelInformation((open) => !open)}
                    title="View model information"
                    aria-label="View model information"
                    aria-expanded={showModelInformation}
                  >
                    <Info size={16} />
                    <span>Information</span>
                  </button>
                  <span className="tool-divider" />
                  <button
                    className={`viewer-tool ${showLabels ? 'tool-active' : ''}`}
                    onClick={() => setShowLabels(!showLabels)}
                    title="Toggle labels"
                  >
                    <Eye size={16} />
                    <span>Labels</span>
                  </button>
                  <span className="tool-divider" />
                  <button
                    className="icon-button"
                    title="Zoom in"
                    aria-label="Zoom in"
                    onClick={() => {
                      setZoomCommand({
                        direction: 'in',
                        id: Date.now(),
                      })
                    }}
                  >
                    <ZoomIn size={17} />
                  </button>
                  <button
                    className="icon-button"
                    title="Zoom out"
                    aria-label="Zoom out"
                    onClick={() => {
                      setZoomCommand({
                        direction: 'out',
                        id: Date.now(),
                      })
                    }}
                  >
                    <ZoomOut size={17} />
                  </button>
                  <button
                    className="icon-button fullscreen-toggle"
                    title={isFullscreen ? "Exit full screen (Esc)" : "Analyze diagram full screen"}
                    aria-label={isFullscreen ? "Exit full screen" : "Analyze diagram full screen"}
                    onClick={async () => {
                      if (!fullscreenElement) return
                      try {
                        if (document.fullscreenElement) {
                          await document.exitFullscreen()
                        } else {
                          await fullscreenElement.requestFullscreen()
                        }
                      } catch (error) {
                        console.error("Fullscreen could not be opened:", error)
                      }
                    }}
                  >
                    {isFullscreen ? <Minimize2 size={17} /> : <Maximize2 size={17} />}
                  </button>
                  <button
                    className={`icon-button ${showViewerSettings ? 'tool-active' : ''}`}
                    title="View settings"
                    aria-label="Toggle viewer settings"
                    onClick={() => setShowViewerSettings((visible) => !visible)}
                  >
                    <Settings2 size={17} />
                  </button>
                </div>
              </div>

              <div className={`viewer-canvas actual-3d-canvas viewer-mode-${viewerDisplayMode}`}>
                {showViewerSettings && (
                  <div className="viewer-settings-popover">
                    <div className="viewer-settings-heading">
                      <strong>Viewer settings</strong>
                      <button
                        className="icon-button"
                        onClick={() => setShowViewerSettings(false)}
                        aria-label="Close viewer settings"
                      >
                        ×
                      </button>
                    </div>
                    <div className="viewer-display-mode">
                      <span className="viewer-display-mode-label">Display mode</span>
                      <div className="viewer-display-mode-options">
                        <button
                          className={`display-mode-button ${viewerDisplayMode === 'default' ? 'display-mode-active' : ''}`}
                          title="Default holographic background"
                          aria-label="Default display mode"
                          aria-pressed={viewerDisplayMode === 'default'}
                          onClick={() => setViewerDisplayMode('default')}
                        >
                          ☀
                        </button>
                        <button
                          className={`display-mode-button ${viewerDisplayMode === 'dark' ? 'display-mode-active' : ''}`}
                          title="Dark mode"
                          aria-label="Dark display mode"
                          aria-pressed={viewerDisplayMode === 'dark'}
                          onClick={() => setViewerDisplayMode('dark')}
                        >
                          ☾
                        </button>
                        <button
                          className={`display-mode-button ${viewerDisplayMode === 'glass' ? 'display-mode-active' : ''}`}
                          title="Transparent glass mode"
                          aria-label="Glass display mode"
                          aria-pressed={viewerDisplayMode === 'glass'}
                          onClick={() => setViewerDisplayMode('glass')}
                        >
                          ◇
                        </button>
                      </div>
                    </div>
                    <label className="viewer-setting-row">
                      <span>Neuron labels</span>
                      <input
                        type="checkbox"
                        checked={showLabels}
                        onChange={() => setShowLabels((visible) => !visible)}
                      />
                    </label>
                    <p>Explore your model by selecting a component to understand its function and role in the overall system.</p>
                  </div>
                )}
                <div className="viewer-rotation-controls">
                  <button
                    className="rotation-button"
                    title="Top view"
                    aria-label="Top view"
                    onClick={() => setRotationCommand({ direction: 'up', id: Date.now() })}
                  >
                    ↑
                  </button>
                  <button
                    className="rotation-button"
                    title="Bottom view"
                    aria-label="Bottom view"
                    onClick={() => setRotationCommand({ direction: 'down', id: Date.now() })}
                  >
                    ↓
                  </button>
                  <button
                    className="rotation-button"
                    title="Left view"
                    aria-label="Left view"
                    onClick={() => setRotationCommand({ direction: 'left', id: Date.now() })}
                  >
                    ←
                  </button>
                  <button
                    className="rotation-button"
                    title="Right view"
                    aria-label="Right view"
                    onClick={() => setRotationCommand({ direction: 'right', id: Date.now() })}
                  >
                    →
                  </button>
                  <button
                    className="rotation-button"
                    title="Reset to default view"
                    aria-label="Reset to default view"
                    onClick={() => {
                      setAutoRotate(false)
                      setSelectedNeuron(null)
                      setRotationCommand({ direction: 'reset', id: Date.now() })
                    }}
                  >
                    ⌂
                  </button>
                  <button
                    className={`rotation-button rotation-toggle ${autoRotate ? 'rotation-active' : ''}`}
                    title={autoRotate ? 'Stop rotation' : 'Start 360° rotation'}
                    aria-label={autoRotate ? 'Stop rotation' : 'Start 360 degree rotation'}
                    aria-pressed={autoRotate}
                    onClick={() => setAutoRotate((rotating) => !rotating)}
                  >
                    ⟳
                  </button>
                  <button
                    type="button"
                    className={`rotation-button rotation-toggle ${atomicSimulationOn ? 'rotation-active' : ''}`}
                    title={atomicSimulationOn ? 'Pause simulation' : 'Start simulation'}
                    aria-label={atomicSimulationOn ? 'Pause simulation' : 'Start simulation'}
                    aria-pressed={atomicSimulationOn}
                    onClick={() => setAtomicSimulationOn((running) => !running)}
                  >
                    {atomicSimulationOn ? '⏸' : '▶'}
