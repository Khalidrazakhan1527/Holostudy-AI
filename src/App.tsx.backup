                    rotationCommand={rotationCommand}
                    autoRotate={autoRotate}
                    simulationOn={atomicSimulationOn}
                    displayMode={viewerDisplayMode}
                  />
                ) : selectedModel === 'Atomic Structure' ? (
                  <div className="atomic-workspace">
                    <div className="atomic-element-toolbar atomic-element-toolbar-compact">
                      <div className="atomic-element-summary">
                        <strong className="atomic-element-symbol">{selectedElement.symbol}</strong>
                        <div>
                          <strong>{selectedElement.name}</strong>
                          <span>Atomic number: {selectedElement.atomicNumber} · {Math.max(0, selectedElement.atomicNumber - ionCharge)} electrons</span>
                        </div>
                      </div>
                      <button
                        type="button"
                        className="atomic-select-element-button"
                        onClick={() => {
                          setPendingElementNumber(selectedElementNumber)
                          setShowElementPicker(true)
                        }}
                      >
                        <Atom size={16} />
                        Select Element
                      </button>
                    </div>

                    {showElementPicker && (
                      <div
                        className="atomic-dialog-backdrop"
                        role="presentation"
                        onMouseDown={(event) => {
                          if (event.target === event.currentTarget) setShowElementPicker(false)
                        }}
                      >
                        <section
                          className="atomic-element-dialog"
                          role="dialog"
                          aria-modal="true"
                          aria-labelledby="atomic-dialog-title"
                        >
                          <div className="atomic-dialog-heading">
                            <div>
                              <span>CHEMISTRY EXPLORER</span>
                              <h2 id="atomic-dialog-title">Select an element</h2>
                            </div>
                            <button
                              type="button"
                              className="icon-button"
                              aria-label="Close element selection"
                              onClick={() => setShowElementPicker(false)}
                            >
                              ×
                            </button>
                          </div>

                          <label htmlFor="atomic-element-select">Element</label>
                          <select
                            id="atomic-element-select"
                            value={pendingElementNumber}
                            onChange={(event) => setPendingElementNumber(Number(event.target.value))}
                            autoFocus
                          >
                            {ELEMENTS.map((element) => (
                              <option key={element.atomicNumber} value={element.atomicNumber}>
                                {element.atomicNumber}. {element.name} ({element.symbol})
                              </option>
                            ))}
                          </select>

                          <label htmlFor="atomic-charge-select">Ion charge</label>
                          <select
                            id="atomic-charge-select"
                            value={ionCharge}
                            onChange={(event) => setIonCharge(Number(event.target.value))}
                          >
                            <option value={0}>Neutral atom (0)</option>
                            <option value={1}>Positive ion (+1)</option>
                            <option value={-1}>Negative ion (−1)</option>
                          </select>

                          <div className="atomic-dialog-preview">
                            <strong>{ELEMENTS.find((element) => element.atomicNumber === pendingElementNumber)?.symbol}</strong>
                            <div>
                              <b>{ELEMENTS.find((element) => element.atomicNumber === pendingElementNumber)?.name}</b>
                              <span>Atomic number: {pendingElementNumber}</span>
                            </div>
                          </div>

                          <div className="atomic-dialog-actions">
                            <button
                              type="button"
                              className="atomic-dialog-cancel"
                              onClick={() => setShowElementPicker(false)}
                            >
                              Cancel
                            </button>
                            <button
                              type="button"
                              className="atomic-dialog-confirm"
                              onClick={() => {
