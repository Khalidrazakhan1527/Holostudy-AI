                          ['Pulmonary circulation', 'Moves blood between the heart and lungs'],
                          ['Systemic circulation', 'Moves blood between the heart and the body'],
                          ['Electrical conduction', 'SA node, AV node, bundle branches and Purkinje fibres coordinate contractions'],
                        ].map(([label, value]) => (
                          <div key={label} style={{ padding: '11px 0', borderBottom: '1px solid rgba(115,205,255,0.15)' }}>
