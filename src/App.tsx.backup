                          position: 'absolute',
                          left: 20,
                          top: 90,
                          zIndex: 1000,
                          width: 'min(300px, calc(100% - 32px))',
                          maxHeight: '45%',
                          overflowY: 'auto',
                          padding: 16,
                          border: '1px solid rgba(93, 205, 255, 0.45)',
                          borderRadius: 14,
                          background: 'rgba(5, 18, 36, 0.94)',
                          color: '#eef7ff',
                          boxShadow: '0 8px 32px rgba(0, 0, 0, 0.35)',
                          backdropFilter: 'blur(14px)',
                        }}
                      >
                        <div
                          style={{
                            display: 'flex',
                            justifyContent: 'space-between',
                            alignItems: 'center',
                            gap: 12,
                            marginBottom: 12,
                          }}
                        >
                          <div>
                            <span
                              style={{
                                display: 'block',
                                fontSize: 10,
                                letterSpacing: 1.5,
                                color: '#65d5ff',
                                marginBottom: 4,
                              }}
                            >
                              ELECTRON INSPECTOR
                            </span>
                            <strong>
                              {selectedElectron
                                ? `Electron ${selectedElectron.number}`
                                : 'Select an electron'}
                            </strong>
                          </div>
                          {selectedElectron && (
                            <span style={{ fontSize: 24, color: '#65d5ff' }}>e⁻</span>
                          )}
                        </div>

                        {selectedElectron ? (
                          <div style={{ display: 'grid', gap: 9, fontSize: 13 }}>
                            <div style={{ display: 'flex', justifyContent: 'space-between', gap: 12 }}>
                              <span>Electron number</span>
                              <strong>{selectedElectron.number}</strong>
                            </div>
                            <div style={{ display: 'flex', justifyContent: 'space-between', gap: 12 }}>
                              <span>Shell</span>
                              <strong>{selectedElectron.shell}</strong>
                            </div>
                            <div style={{ display: 'flex', justifyContent: 'space-between', gap: 12 }}>
                              <span>Charge</span>
                              <strong>−1e</strong>
                            </div>
                            <div style={{ display: 'flex', justifyContent: 'space-between', gap: 12 }}>
                              <span>Charge (C)</span>
                              <strong>−1.602 × 10⁻¹⁹ C</strong>
                            </div>
                            <div style={{ display: 'flex', justifyContent: 'space-between', gap: 12 }}>
                              <span>Rest mass</span>
                              <strong>9.109 × 10⁻³¹ kg</strong>
                            </div>
                            <div
                              style={{
                                marginTop: 4,
                                paddingTop: 10,
                                borderTop: '1px solid rgba(150, 200, 230, 0.2)',
                                color: '#a9c4d9',
                                lineHeight: 1.5,
                              }}
                            >
                              This electron belongs to the {selectedElectron.shell}
                              {selectedElectron.shell === 1 ? 'st' : selectedElectron.shell === 2 ? 'nd' : selectedElectron.shell === 3 ? 'rd' : 'th'}
                              electron shell of {selectedElement.name}.
                            </div>
                          </div>
                        ) : (
                          <p style={{ margin: 0, fontSize: 12, lineHeight: 1.6, color: '#a9c4d9' }}>
                            Click a glowing electron in the 3D atom to inspect its shell,
                            charge and physical properties.
                          </p>
                        )}
                      </section>
                    )}
                  </div>
                ) : selectedModel === 'Human Heart' ? (
                  <HumanHeart3D
                    showLabels={showLabels}
                    autoRotate={autoRotate}
                    simulationOn={atomicSimulationOn}
                    displayMode={viewerDisplayMode}
                    zoomCommand={zoomCommand}
                    onZoomComplete={() => setZoomCommand(null)}
                    rotationCommand={rotationCommand}
                  />
                ) : selectedModel === 'Computer Architecture' ? (
                  <ComputerArchitecture3D
                    showLabels={showLabels}
                    autoRotate={autoRotate}
                    simulationOn={atomicSimulationOn}
                    displayMode={viewerDisplayMode}
                    zoomCommand={zoomCommand}
                    onZoomComplete={() => setZoomCommand(null)}
                    rotationCommand={rotationCommand}
                  />
                ) : (
                  <div className="model-coming-soon">
                    <currentModel.icon size={42} strokeWidth={1.3} />
                    <strong>{currentModel.name}</strong>
                    <span>This model will be implemented in a later step.</span>
                    <button onClick={() => setSelectedModel('Neural Network')}>
                      Open Neural Network
                    </button>
                  </div>
                )}

                {showModelInformation && (
                  <section
                    role="dialog"
                    aria-label={`${selectedModel} information`}
                    className="model-information-panel"
                    style={{
                      position: 'absolute',
                      top: 58,
                      right: 16,
                      zIndex: 1200,
                      width: 'min(390px, calc(100% - 32px))',
                      maxHeight: 'calc(100% - 100px)',
                      overflowY: 'auto',
                      padding: 20,
                      border: '1px solid rgba(93, 205, 255, 0.4)',
                      borderRadius: 16,
                      background: 'rgba(5, 17, 35, 0.97)',
                      color: '#eef7ff',
                      boxShadow: '0 12px 40px rgba(0,0,0,0.38)',
                      backdropFilter: 'blur(16px)',
                    }}
                  >
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', gap: 12, marginBottom: 18 }}>
                      <div>
                        <span style={{ fontSize: 10, letterSpacing: 1.6, color: '#65d5ff' }}>
                          HOLOSTUDY AI · MODEL GUIDE
                        </span>
                        <h2 style={{ margin: '6px 0 0', fontSize: 21 }}>{selectedModel}</h2>
                        <p style={{ margin: '5px 0 0', fontSize: 12, lineHeight: 1.5, color: '#a9c4d9' }}>
                          {currentModel.description}
                        </p>
                      </div>
                      <button
                        type="button"
                        className="icon-button"
                        aria-label="Close information panel"
                        title="Close information"
                        onClick={() => setShowModelInformation(false)}
                      >
                        ×
                      </button>
                    </div>

                    {selectedModel === 'Atomic Structure' ? (
                      <>
                        <div style={{ display: 'flex', alignItems: 'center', gap: 14, padding: 14, borderRadius: 12, background: 'rgba(75, 195, 255, 0.09)', marginBottom: 16 }}>
                          <strong style={{ fontSize: 38, color: '#65d5ff' }}>{selectedElement.symbol}</strong>
                          <div>
                            <strong style={{ display: 'block', fontSize: 17 }}>{selectedElement.name}</strong>
                            <span style={{ fontSize: 12, color: '#a9c4d9' }}>{selectedElement.category}</span>
                            <div style={{ fontSize: 11, marginTop: 4 }}>Atomic number {selectedElement.atomicNumber}</div>
                          </div>
                        </div>

                        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2, minmax(0, 1fr))', gap: 9 }}>
                          {[
                            ['Atomic mass', selectedElement.atomicMass == null ? 'Unknown' : `${selectedElement.atomicMass} u`],
                            ['Protons', String(selectedElement.atomicNumber)],
                            ['Electrons', String(Math.max(0, selectedElement.atomicNumber - ionCharge))],
                            ['Neutrons (estimated)', selectedElement.commonMassNumber == null ? 'Unknown' : String(Math.max(0, selectedElement.commonMassNumber - selectedElement.atomicNumber))],
                            ['Group', selectedElement.group == null ? 'Lanthanide / actinide series' : String(selectedElement.group)],
                            ['Period', String(selectedElement.period)],
                            ['Block', /[spdf]/.test(selectedElement.electronConfiguration.replace(/^.*\]\s*/, '').slice(-2, -1)) ? selectedElement.electronConfiguration.replace(/^.*\]\s*/, '').match(/[spdf]/g)?.slice(-1)[0]?.toUpperCase() + '-block' : 'See configuration'],
                            ['Ion charge', ionCharge > 0 ? `+${ionCharge}` : String(ionCharge)],
                            ['Occupied shells', String(selectedElement.shells.filter((count) => count > 0).length)],
                            ['Valence electrons (neutral)', String(selectedElement.shells[selectedElement.period - 1] ?? 0)],
                          ].map(([label, value]) => (
                            <div key={label} style={{ minWidth: 0, padding: 11, borderRadius: 9, border: '1px solid rgba(115,205,255,0.18)', background: 'rgba(66,207,255,0.045)' }}>
                              <div style={{ fontSize: 10, color: '#a9c4d9', marginBottom: 5 }}>{label}</div>
                              <strong style={{ fontSize: 13, overflowWrap: 'anywhere' }}>{value}</strong>
                            </div>
                          ))}
